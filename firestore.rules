rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /videos/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['videoId', 'name', 'text', 't', 'at'])
        && request.resource.data.videoId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 200
        && request.resource.data.t is number
        && request.resource.data.t >= 0;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /admins/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isAdmin());
      allow write: if false;
    }
  }
}
